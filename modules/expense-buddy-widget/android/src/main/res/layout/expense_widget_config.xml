<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/expense_widget_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/config_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expense_widget_config_title"
            android:textColor="@color/expense_widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/config_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/expense_widget_config_subtitle"
            android:textColor="@color/expense_widget_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/config_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/config_category"
            android:text="@string/expense_widget_config_category"
            android:textColor="@color/expense_widget_text_muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:clickable="false">

            <Spinner
                android:id="@+id/config_category"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown" />

            <ImageView
                android:id="@+id/config_category_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/expense_widget_chevron_down" />
        </FrameLayout>

        <Switch
            android:id="@+id/config_hide_amounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/expense_widget_config_hide_amounts"
            android:textColor="@color/expense_widget_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="56dp"
            android:text="@string/expense_widget_config_save"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
